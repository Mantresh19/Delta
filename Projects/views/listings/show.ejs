<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
    <div class="col-8 offset-2">
    <h3><%= listing.title %></h3>
    <div class="card">
        <img src="<%= listing.image %>" class="card-img-top show-img mb-2 mt-2" alt="listing_image">
        <div class="card-body">
            <p class="card-text"><br>
            <%= listing.description %> <br>
            £ <%= listing.price.toLocaleString("en-IN") %> <br>
            <%= listing.location %> <br>
            <%= listing.country %> <br>
            </p>
        </div>
    </div>
        <div class="show-btn">
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark">Edit this listing</a>
        <br><br>
        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
            <button class="btn btn-dark">Delete this listing</button>
        </form>
        </div>
    </div>
</div>

<div class="col-8 offset-2 mb-3">
    <hr>
    <h4>Leave a Review</h4>
    <!-- <form action="/listings//reviews" method="POST" novalidate class="needs validation"> -->
        <div class="mb-3 mt-3">
            <label for="rating" class="form-label">Rating</label>
            <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range">
        </div>
        <div class="mb-3 mt-3">
            <label for="comment" class="form-label">Comments</label>
            <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control" required></textarea>
        </div>
        <div class="invalid-feedback">Please Add a Review</div>
        <button class="btn btn-outline-dark">Submit</button>
    </form>
</div>